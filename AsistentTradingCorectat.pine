//@version=5
indicator("Asistent Trading Complet Corectat", overlay=true, max_labels_count=500)

// --- Grup: Inputuri Utilizator
// =============================================================================
accountSize = input.float(1000, "Dimensiune cont (€)", group="Managementul Riscului")
riskPercent = input.float(1, "Risc per tranzacție (%)", group="Managementul Riscului")
riskMultiplier = input.float(2.0, "Factor Risc/Profit (RR)", group="Managementul Riscului")
showAlerts = input.bool(true, "Activează Alertele?", group="Alerte")

// --- Grup: Indicatori Tehnici
// =============================================================================
// Medii Mobile
fastLength = input.int(14, "MA Rapidă", group="Indicatori")
slowLength = input.int(50, "MA Lentă", group="Indicatori")
// RSI
rsiLength = input.int(14, "RSI Lungime", group="Indicatori")
rsiOverbought = input.int(70, "RSI Supracumpărat", group="Indicatori")
rsiOversold = input.int(30, "RSI Supravândut", group="Indicatori")
// MACD
macdFast = input.int(12, "MACD Fast", group="Indicatori")
macdSlow = input.int(26, "MACD Slow", group="Indicatori")
macdSignal = input.int(9, "MACD Signal", group="Indicatori")
// ATR
atrLength = input.int(14, "ATR Lungime", group="Indicatori")
// Suport si Rezistenta
supportResistanceLookback = input.int(20, "Perioada Suport/Rezistență", group="Indicatori")

// --- Calcul Indicatori
// =============================================================================
maFast = ta.sma(close, fastLength)
maSlow = ta.sma(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
atrValue = ta.atr(atrLength)
support = ta.lowest(low, supportResistanceLookback)
resistance = ta.highest(high, supportResistanceLookback)

// --- Definirea Semnalelor de Tranzacționare
// =============================================================================
longSignal = ta.crossover(maFast, maSlow) and rsiValue < rsiOverbought and macdLine > signalLine
shortSignal = ta.crossunder(maFast, maSlow) and rsiValue > rsiOversold and macdLine < signalLine

// --- Managementul Stării Tranzacției (variabile persistente)
// =============================================================================
var float longEntry = na
var float longStop = na
var float longTarget = na
var float shortEntry = na
var float shortStop = na
var float shortTarget = na

// --- Calcul Niveluri de Intrare / Stop / Target (doar la semnal)
// =============================================================================
if (longSignal)
    longEntry := close
    longStop := longEntry - atrValue
    longTarget := longEntry + atrValue * riskMultiplier
    // Resetează valorile short pentru a curăța graficul
    shortEntry := na
    shortStop := na
    shortTarget := na

if (shortSignal)
    shortEntry := close
    shortStop := shortEntry + atrValue
    shortTarget := shortEntry - atrValue * riskMultiplier
    // Resetează valorile long pentru a curăța graficul
    longEntry := na
    longStop := na
    longTarget := na

// --- Calcul Unități/Loturi Recomandate
// =============================================================================
riskAmount = accountSize * (riskPercent / 100)
// Folosim o valoare minimă pentru a evita împărțirea la zero
stopDistanceLong = math.max(longEntry - longStop, 1e-9)
stopDistanceShort = math.max(shortStop - shortEntry, 1e-9)

longUnits = riskAmount / stopDistanceLong
shortUnits = riskAmount / stopDistanceShort

// --- Plotare pe Grafic
// =============================================================================
// Medii Mobile
plot(maFast, color=color.new(color.blue, 0), title="MA Rapidă")
plot(maSlow, color=color.new(color.red, 0), title="MA Lentă")

// Suport și Rezistență
plot(support, color=color.new(color.green, 50), title="Suport", style=plot.style_linebr)
plot(resistance, color=color.new(color.red, 50), title="Rezistență", style=plot.style_linebr)

// Semnale de Cumpărare/Vânzare
plotshape(longSignal, title="Semnal Cumpărare", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.large)
plotshape(shortSignal, title="Semnal Vânzare", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.large)

// Niveluri de Stop și Target (se afișează doar după semnal)
plot(longStop, color=color.new(color.red, 0), title="Stop Long", style=plot.style_circles, linewidth=2)
plot(longTarget, color=color.new(color.green, 0), title="Target Long", style=plot.style_circles, linewidth=2)
plot(shortStop, color=color.new(color.red, 0), title="Stop Short", style=plot.style_circles, linewidth=2)
plot(shortTarget, color=color.new(color.green, 0), title="Target Short", style=plot.style_circles, linewidth=2)

// --- Etichete Informative pe Grafic
// =============================================================================
if (longSignal)
    label.new(bar_index, low - atrValue * 0.5,
      text="CUMPĂRĂ\n" +
      "Intrare: " + str.tostring(longEntry, format.mintick) + "\n" +
      "Stop: " + str.tostring(longStop, format.mintick) + "\n" +
      "Target: " + str.tostring(longTarget, format.mintick) + "\n" +
      "Unități: " + str.tostring(longUnits, "#.##"),
      style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

if (shortSignal)
    label.new(bar_index, high + atrValue * 0.5,
      text="VINDE\n" +
      "Intrare: " + str.tostring(shortEntry, format.mintick) + "\n" +
      "Stop: " + str.tostring(shortStop, format.mintick) + "\n" +
      "Target: " + str.tostring(shortTarget, format.mintick) + "\n" +
      "Unități: " + str.tostring(shortUnits, "#.##"),
      style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

// --- Alerte Dinamice
// =============================================================================
// Construim mesajul de alertă dinamic
alertMessageLong = "Semnal CUMPĂRĂ " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + "\n" +
                   "Stop: " + str.tostring(longStop, format.mintick) + "\n" +
                   "Target: " + str.tostring(longTarget, format.mintick)

alertMessageShort = "Semnal VINDE " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + "\n" +
                    "Stop: " + str.tostring(shortStop, format.mintick) + "\n" +
                    "Target: " + str.tostring(shortTarget, format.mintick)

if (showAlerts)
    if (longSignal)
        alert(alertMessageLong, alert.freq_once_per_bar)
    if (shortSignal)
        alert(alertMessageShort, alert.freq_once_per_bar)
